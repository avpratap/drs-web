# FastAPI backend origin (no trailing slash). Used by the Next.js server (route handlers) —
# the browser only talks to this app's same-origin /api/* routes. Also the media origin:
# product photos, CMS images and signed invoice PDFs are served from it.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Public origin of this storefront (no trailing slash). Used for canonical URLs and
# metadataBase (app/layout.tsx), Open Graph/JSON-LD URLs (components/marketing/json-ld.tsx)
# and the sitemap line in robots.txt (app/robots.ts) — set it to the real https domain in
# production or those point at localhost. Defaults to http://localhost:3100 (lib/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Online payments (Razorpay) — set to "true" once the gateway keys are configured on the
# backend; off, checkout offers pay-on-delivery only (lib/payments.ts).
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# FSSAI licence number shown in the footer and on /about (optional).
NEXT_PUBLIC_FSSAI_LICENSE=
